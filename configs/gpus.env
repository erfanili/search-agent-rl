# The single source of truth for which GPUs this project may use right now.
# Every script in scripts/ and check_gpus() in encode_corpus.py read this file.
# When your allowance changes (2, 4, 6 ... GPUs), edit GPUS here and nowhere else.

# Physical GPU indices from nvidia-smi, comma-separated, no spaces.
GPUS=0,1,2,3

# GPU for the retrieval server; must be one of GPUS. Leave empty to use the last one in GPUS.
# Training scripts leave this GPU out while the server is running.
RETRIEVAL_GPU=
