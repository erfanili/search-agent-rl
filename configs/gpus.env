# The single source of truth for which GPUs this project may use right now.
# Every script in scripts/ and check_gpus() in retrieval/encode_corpus.py read this file.
# When your allowance changes (2, 4, 6 ... GPUs), edit GPUS here and nowhere else.

# Physical GPU indices from nvidia-smi, comma-separated, no spaces.
GPUS=4,5,6,7

# GPU for the retrieval server's e5 query encoder (FAISS search runs on CPU either way); must be one
# of GPUS, or "cpu" to keep every GPU for training. Leave empty to use the last one in GPUS.
# Training scripts leave this GPU out.
RETRIEVAL_GPU=cpu
